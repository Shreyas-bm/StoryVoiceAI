# Database configuration (defaults to in-memory fallback if not provided)
DATABASE_URL=postgresql://storyvoice_user:storyvoice_password@localhost:5432/storyvoice_db

# Redis connection url for task management (e.g. Celery)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 object storage configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=storyvoice_minio
MINIO_SECRET_KEY=storyvoice_minio_password
MINIO_SECURE=False
